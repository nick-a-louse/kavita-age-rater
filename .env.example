# Copy to /srv/kavita-age-rater/.env on your server and fill in. Never commit .env.
# Create it locked down BEFORE adding secrets:  sudo install -m 600 /dev/null .env
TZ=Europe/London

# --- Container user (same as my other containers) ---
# Docker runs the app as this user and group. /opt/appdata/kavita-age-rater must be owned by them.
PUID=1003
PGID=1006

# --- Kavita ---
KAVITA_URL=http://your-server:5053
# The token from your Kavita OPDS URL (Settings → Account)
KAVITA_API_KEY=your-kavita-api-key

# --- Claude ---
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the Claude model
# AGE_RATER_MODEL=claude-opus-4-8

# --- Background scanner ---
# Classify unrated books automatically, every INTERVAL_HOURS
AUTO_SCAN=true
INTERVAL_HOURS=24
