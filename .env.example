# Copy to .env and fill in.  .env is gitignored; this template is safe to commit.
KAVITA_URL=http://your-server:5053
KAVITA_API_KEY=your-kavita-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# RUN_MODE for the scheduled loop:
#   scan  = classify + write review file only (default, safest)
#   apply = push reviewed proposals.csv to Kavita
#   auto  = classify + apply in one pass (uncertain books left Unknown/hidden)
RUN_MODE=scan
INTERVAL_HOURS=24

# Host path for persistent state (cache, proposals.csv, log).
# On the server set this to the appdata folder; defaults to ./data locally.
# DATA_PATH=/opt/appdata/age_rater
