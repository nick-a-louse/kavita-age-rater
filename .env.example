# Copy to .env and fill in.  .env is gitignored; this template is safe to commit.
KAVITA_URL=http://your-server:5053
KAVITA_API_KEY=your-kavita-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Web UI: browse to http://<server-ip>:HOST_PORT
HOST_PORT=5058

# Background scanner: classify unrated books automatically on this cadence.
AUTO_SCAN=true
INTERVAL_HOURS=24

# Host path for persistent state (SQLite db + log). Matches the appdata convention.
DATA_PATH=/opt/appdata/kavita-age-rater

# Optional: override the Claude model.
# AGE_RATER_MODEL=claude-opus-4-8
